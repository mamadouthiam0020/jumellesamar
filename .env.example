# ============================================
# Jumelles Amar - Environment Configuration
# ============================================
# Copy this file to .env.dev and .env.prod and fill in your values

# Environment
NODE_ENV=development
PORT=5000

# MongoDB Atlas - DEV cluster
MONGODB_URI=mongodb+srv://<username>:<password>@cluster-dev.xxxxx.mongodb.net/jumelles_amar_dev?retryWrites=true&w=majority

# JWT
JWT_SECRET=change_this_to_a_random_secure_string
JWT_EXPIRE=7d

# Cloudinary (image upload)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# CORS
CORS_ORIGIN=http://localhost:3000

# Admin bootstrap (first admin account auto-created if none exists)
ADMIN_EMAIL=admin@jumellesamar.com
ADMIN_PASSWORD=adminJumelles2024!
ADMIN_NAME=Admin Jumelles Amar
